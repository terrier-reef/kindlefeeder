{
  "manifest_version": 3,
  "name": "KindleFeeder",
  "version": "1.0",
  "description": "Send any article to your Kindle over USB.",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Kindle"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
